@echo off
chcp 65001 >nul
title 每日涨停池同步
echo ========================================================
echo   抓取每日涨停池、连续板数与涨停原因...
echo ========================================================
python "%~dp0sync_limit_up.py" %*
if errorlevel 1 goto failed
echo.
echo ========================================================
echo   同步完成！请打开 index.html 或在浏览器按 F5 查看快照。
echo ========================================================
pause
exit /b 0
:failed
echo.
echo   同步失败，请查看上方错误。不要将旧快照当作今日数据。
pause
exit /b 1
